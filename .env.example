# ---- Supabase (OPTIONAL) -------------------------------------------------
# Leave blank to run the app in guest mode (localStorage persistence only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose. Used by nothing in the MVP but reserved for
# future admin/billing tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage bucket for logos / signatures / QR codes.
NEXT_PUBLIC_SUPABASE_BUCKET=invoice-assets
